import re

# Relative to the working directory, so that running with --directory .test
# picks up the test config. An explicit --configfile takes precedence.
if not config:

    configfile: "config/config.yaml"


localrules:
    all,


include: "rules/common.smk"


wildcard_constraints:
    sample="({})".format(
        "|".join(re.escape(s) for s in sample_list + sanger_sample_list) or "^$"
    ),
    side="forward|reverse",
    read="R1|R2",


rule all:
    input:
        workflow_targets(),


include: "rules/reference.smk"


if sample_list:

    include: "rules/ngs.smk"
    include: "rules/sites.smk"


if sanger_sample_list:

    include: "rules/sanger.smk"


if do_validation:

    include: "rules/validation.smk"
